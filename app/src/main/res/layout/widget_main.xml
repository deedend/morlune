<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clip"
    android:clipToOutline="true"
    android:outlineProvider="background">

    <!-- Tinted + alpha'd from code: the colour panel, then the weather picture on top of it. -->
    <ImageView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_panel" />

    <ImageView
        android:id="@+id/weather_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/clock_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="64sp"
                    android:textColor="#FFFFFFFF"
                    android:shadowColor="#99000000"
                    android:shadowRadius="3"
                    android:shadowDy="1" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE d MMMM"
                    android:format24Hour="EEEE d MMMM"
                    android:textSize="15sp"
                    android:textColor="#FFFFFFFF"
                    android:shadowColor="#99000000"
                    android:shadowRadius="3"
                    android:shadowDy="1" />

                <TextView
                    android:id="@+id/location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:textColor="#FFFFFFFF"
                    android:shadowColor="#99000000"
                    android:shadowRadius="3"
                    android:shadowDy="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weather_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="36sp"
                    android:textColor="#FFFFFFFF"
                    android:shadowColor="#99000000"
                    android:shadowRadius="3"
                    android:shadowDy="1" />

                <TextView
                    android:id="@+id/minmax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="#FFFFFFFF"
                    android:shadowColor="#99000000"
                    android:shadowRadius="3"
                    android:shadowDy="1" />

                <TextView
                    android:id="@+id/rain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#FFFFFFFF"
                    android:shadowColor="#99000000"
                    android:shadowRadius="3"
                    android:shadowDy="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/forecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/calendar_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cal_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FFFFFFFF"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cal_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
